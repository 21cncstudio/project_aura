                  "useStyle": "style_text_primary",
                  "localStyles": {
                    "objID": "d941af41-05df-4972-b2af-b1ce2810cd15",
                    "definition": {
                      "MAIN": {
                        "DEFAULT": {
                          "text_font": "jet_reg_18"
                        }
                      }
                    }
                  },
                  "group": "",
                  "groupIndex": 0,
                  "text": "Formaldehyde (HCHO) is a carcinogenic VOC released from pressed wood, furniture, flooring, adhesives, and textiles. Thresholds based on WHO guidelines (~80 µg/m³ ≈ 65 ppb). New furniture and renovations are major sources. Causes eye, nose, and throat irritation. Levels decrease over time as materials off-gas. Ventilate new spaces thoroughly for several weeks.",
                  "textType": "literal",
                  "longMode": "WRAP",
                  "recolor": false
                },
                {
                  "objID": "3af4329a-8434-4441-a360-b368bb1686fa",
                  "type": "LVGLContainerWidget",
                  "left": 0,
                  "top": 140,
                  "width": 800,
                  "height": 268,
                  "customInputs": [],
