                      }
                    }
                  },
                  "group": "",
                  "groupIndex": 0,
                  "text": "AQI is a realtime overall air quality score for this device. It combines particulate, ventilation, and gas signals into one index from 0 to 100, where lower is better. The score reacts mainly to the worst pollution source, then adds smaller penalties from other elevated groups. Use AQI for a quick overview, then check individual sensors to find the main cause.",
                  "textType": "literal",
                  "longMode": "WRAP",
                  "recolor": false
                },
