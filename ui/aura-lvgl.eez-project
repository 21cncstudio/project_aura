                      "identifier": "label_pm25_text",
                      "leftUnit": "px",
                      "topUnit": "px",
                      "widthUnit": "px",
                      "heightUnit": "content",
                      "children": [],
                      "widgetFlags": "",
                      "hiddenFlagType": "literal",
                      "clickableFlagType": "literal",
                      "flagScrollbarMode": "",
                      "flagScrollDirection": "",
                      "scrollSnapX": "",
                      "scrollSnapY": "",
                      "checkedStateType": "literal",
                      "disabledStateType": "literal",
                      "states": "",
                      "useStyle": "style_text_primary",
                      "localStyles": {
                        "objID": "fdbbc483-992e-428a-f6db-d35eb59e28f9",
                        "definition": {
                          "MAIN": {
                            "DEFAULT": {
                              "text_font": "jet_reg_18"
                            }
                          }
                        }
                      },
                      "group": "",
                      "groupIndex": 0,
                      "text": "PM2.5 are fine particles that penetrate deep into lungs and bloodstream. Thresholds based on US EPA Air Quality Index (AQI) and WHO guidelines. Long-term exposure linked to respiratory and cardiovascular disease. Sources: cooking, candles, outdoor pollution,smoking. Keep indoor levels low through air filtration and ventilation.",
                      "textType": "literal",
                      "longMode": "WRAP",
                      "recolor": false
                    },
                    {
                      "objID": "5d36dd93-b196-4f42-b36e-9643e61b0082",
                      "type": "LVGLLabelWidget",
                      "left": 20,
                      "top": 17,
                      "width": 760,
                      "height": 120,
                      "customInputs": [],
                      "customOutputs": [],
                      "style": {
                        "objID": "609969d1-3d3a-4da3-a521-8a9983b4572d",
                        "useStyle": "default",
                        "conditionalStyles": [],
                        "childStyles": []
                      },
                      "hiddenInEditor": true,
                      "timeline": [],
                      "eventHandlers": [],
                      "identifier": "label_pm4_text",
                      "leftUnit": "px",
                      "topUnit": "px",
                      "widthUnit": "px",
                      "heightUnit": "content",
                      "children": [],
                      "widgetFlags": "",
                      "hiddenFlagType": "literal",
                      "clickableFlagType": "literal",
                      "flagScrollbarMode": "",
                      "flagScrollDirection": "",
                      "scrollSnapX": "",
                      "scrollSnapY": "",
                      "checkedStateType": "literal",
                      "disabledStateType": "literal",
                      "states": "",
                      "useStyle": "style_text_primary",
                      "localStyles": {
                        "objID": "b9022468-390f-4605-f79f-feeb1fef8b52",
                        "definition": {
                          "MAIN": {
                            "DEFAULT": {
                              "text_font": "jet_reg_18"
                            }
                          }
                        }
                      },
                      "group": "",
                      "groupIndex": 0,
                      "text": "PM4 are respirable particles that reach deep into the respiratory system but are filtered by upper airways better than finer particles. Size range includes some pollen fragments, mold spores, and fine dust. Thresholds based on occupational health standards and interpolation between PM2.5 and PM10 guidelines. Relevant for indoor air quality assessment.",
                      "textType": "literal",
                      "longMode": "WRAP",
                      "recolor": false
                    },
                    {
                      "objID": "34e016b1-c0fc-443f-fa17-bb8e27f128bf",
                      "type": "LVGLContainerWidget",
                      "left": 0,
                      "top": 140,
                      "width": 800,
