                      "useStyle": "style_text_primary",
                      "localStyles": {
                        "objID": "424aba59-e074-494a-889b-1048c1ea3730",
                        "definition": {
                          "MAIN": {
                            "DEFAULT": {
                              "text_font": "jet_reg_18",
                              "text_line_space": 3
                            }
                          }
                        }
                      },
                      "group": "",
                      "groupIndex": 0,
                      "text": "- Power the device from a power bank.\n- Take it outdoors to clean fresh air.\n- Keep it away from people (breath), windows, cars, smoke, vents.\n- Let it run for 10 minutes (minimum 5).\n- Press Calibrate CO2 and keep the device still.\n- Manual calibration is for troubleshooting only.\n- Do not calibrate more than once every 6 months.\n- Calibration uses a 420 ppm reference.\n- Wrong conditions can make readings worse.",
                      "textType": "literal",
                      "longMode": "WRAP",
                      "recolor": false
                    }
                  ],
