                            }
                          },
                          "group": "",
                          "groupIndex": 0,
                          "text": "Poor: <20% or >70%\nHealth risk: respiratory issues or mold growth likely",
                          "textType": "literal",
                          "longMode": "WRAP",
                          "recolor": false
                        },
