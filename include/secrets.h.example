#pragma once
#include <stdint.h>

namespace Secrets {
    // Wi-Fi defaults (optional). Leave empty to require UI setup.
    constexpr const char *WIFI_SSID = "";
    constexpr const char *WIFI_PASS = "";
    constexpr bool WIFI_ENABLED = false;

    // MQTT defaults (optional).
    constexpr const char *MQTT_HOST = "mqtt.local";
    constexpr uint16_t MQTT_PORT = 1883;
    constexpr const char *MQTT_USER = "";
    constexpr const char *MQTT_PASS = "";
    constexpr const char *MQTT_BASE = "project_aura";
    constexpr const char *MQTT_NAME = "Project Aura";
    constexpr bool MQTT_USER_ENABLED = false;
    constexpr bool MQTT_DISCOVERY = true;
    constexpr bool MQTT_ANONYMOUS = false;

    // Aura AQ Link defaults (optional). Leave BASE_URL empty to keep Link off.
    constexpr const char *AURA_LINK_BASE_URL = "";
    constexpr const char *AURA_LINK_ROOT_CA_PEM = "";
    constexpr bool AURA_LINK_ALLOW_INSECURE_TLS = false;
} // namespace Secrets
